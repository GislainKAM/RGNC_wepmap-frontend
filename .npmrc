# Le scope @websig-app est publié sur GitHub Packages, pas sur npmjs.com.
# Le reste des dépendances continue de passer par le registre public.
@websig-app:registry=https://npm.pkg.github.com

# GitHub Packages exige un jeton même pour un paquet public. Il est lu dans
# l'environnement — jamais écrit ici — et doit porter la portée read:packages :
#   export NODE_AUTH_TOKEN=<jeton>   en local
#   build-arg NODE_AUTH_TOKEN=...    pour l'image Docker (voir Dockerfile)
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
